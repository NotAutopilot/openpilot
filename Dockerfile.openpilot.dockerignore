# Use a fresh recursive clone. Keep real Git metadata for setup and versioning,
# but not hooks, reflogs, redundant LFS downloads or other worktrees.
**/.git/hooks
**/.git/**/hooks
**/.git/logs
**/.git/**/logs
**/.git/lfs
**/.git/**/lfs
**/.git/worktrees

# Host environments, caches and native build outputs.
**/.venv
**/venv
**/__pycache__
**/.cache
**/.ci_cache
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.hypothesis
**/.sconsign.dblite
**/.sconsign.dblite.*
**/.coverage*
**/htmlcov
**/build
**/dist
**/obj
**/*.egg-info
**/*.pyc
**/*.pyo
**/*.o
**/*.os
**/*.o-*
**/*.os-*
**/*.so
**/*.a
**/*.dylib
**/*_pyx.cpp
**/*_pyx.h
**/*_pyx_api.h
**/compile_commands.json
**/c_generated_code
openpilot/cereal/gen
openpilot/cereal/services.h
openpilot/selfdrive/pandad/pandad
openpilot/system/camerad/camerad
openpilot/selfdrive/locationd/models/generated
openpilot/tools/jotpluggler/jotpluggler
msgq_repo/gen
msgq_repo/test_runner
rednose_repo/examples/generated
opendbc_repo/opendbc/dbc/*_generated.dbc

# Local build metadata must not override the clone's real Git identity.
build.json

# Personal configuration, credentials, driving data and editor state.
**/.env
**/.env.*
**/.ssh
**/.aws
**/.git-credentials
**/.netrc
**/.idea
**/.vscode
**/.DS_Store
**/.ipynb_checkpoints
userdata
data
params
**/*.rlog
