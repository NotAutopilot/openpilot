# Local CI toolchain image, not a vehicle deployment image.
# Build from a fresh standalone recursive clone with resolved Git LFS files.
# Worktrees with external .git pointers are not portable Docker contexts.
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# setup_dependencies.sh installs the compiler and locked Python dependencies.
# GL is linked by jotpluggler; EGL/GLES are needed by the raylib wheel.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates git sudo tzdata locales libgl-dev libegl1 libgles2 \
    && locale-gen en_US.UTF-8 \
    && useradd --create-home --uid 1001 --shell /bin/bash batman \
    && echo 'batman ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/batman \
    && chmod 0440 /etc/sudoers.d/batman \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 SHELL=/bin/bash CI=1 \
    HOME=/home/batman PATH=/home/batman/.local/bin:${PATH}
USER batman
WORKDIR /home/batman/openpilot
COPY --chown=batman:batman . .

# Keep genuine commits, gitlinks and origins for build metadata. Never invent a
# repository with `git init`, or fetch a different source revision during setup.
RUN if [[ ! -d .git ]]; then \
      echo 'Use a standalone recursive clone, not an external .git worktree pointer.' >&2; exit 1; \
    fi \
    && git rev-parse --verify HEAD \
    && git submodule status --recursive > /tmp/submodule-status \
    && if grep -Eq '^[-+U]' /tmp/submodule-status; then \
      cat /tmp/submodule-status >&2; exit 1; \
    fi \
    && git submodule foreach --recursive 'git rev-parse --verify HEAD' \
    && rm /tmp/submodule-status \
    && ./tools/setup_dependencies.sh \
    && source .venv/bin/activate \
    && git lfs install --local --skip-smudge \
    && git submodule foreach --recursive 'git lfs install --local --skip-smudge' \
    && sudo rm -rf /var/lib/apt/lists/*

CMD ["bash"]
